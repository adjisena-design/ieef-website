---
interface Props { values: number[]; stroke?: string; fill?: string }
const { values, stroke = 'currentColor', fill = 'none' } = Astro.props;
const w = 220, h = 56;
const mn = Math.min(...values), mx = Math.max(...values);
const pts = values.map((v, i) => [(i * w) / (values.length - 1), h - 6 - ((v - mn) / (mx - mn || 1)) * (h - 14)]);
const line = pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const [lx, ly] = pts[pts.length - 1];
---
<svg class="spark" viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none" aria-hidden="true">
  <polygon points={`0,${h} ${line} ${w},${h}`} fill={fill} />
  <polyline points={line} fill="none" stroke={stroke} stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
  <circle cx={lx} cy={ly} r="3.5" fill={stroke} />
</svg>
<style>.spark { width: 100%; height: 64px; }</style>
