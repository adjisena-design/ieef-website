---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Icon from '../Icon.astro';
import PersonCard from './PersonCard.astro';
import type { Person } from '../../lib/content';
import { getPeople, pick, paragraphs } from '../../lib/content';
import { media } from '../../lib/media';
import { getLang, href } from '../../i18n/ui';
import { profile as P } from '../../data/about';

interface Props { person: Person }
const { person } = Astro.props;
const lang = getLang(Astro.url);
const people = await getPeople();
const photo = media(person.photo);
const role = pick(person, 'role', lang);
const bio = paragraphs(pick(person, 'bio', lang));
const bioInOtherLang = lang === 'id' && !person.bio_id;
const i = people.findIndex((p) => p.slug === person.slug);
const others = [1, 2, 3].map((k) => people[(i + k) % people.length]).filter((p) => p.slug !== person.slug);
const socialLabel = person.social_url?.includes('linkedin') ? 'LinkedIn' : person.social_url?.includes('instagram') ? 'Instagram' : P.social[lang];
const description = (paragraphs(pick(person, 'bio', lang))[0] ?? '').slice(0, 155);
---
<Base title={person.name} description={description} image={photo && typeof photo !== 'string' ? photo.src : undefined} jsonLd={{
  '@context': 'https://schema.org', '@type': 'Person', name: person.name, jobTitle: pick(person, 'role', lang) ?? undefined,
  description, url: new URL(Astro.url.pathname, Astro.site).toString(), sameAs: person.social_url ? [person.social_url] : undefined,
  worksFor: { '@type': 'ResearchOrganization', name: 'Institute for Energy, Economics & Finance', url: Astro.site?.toString() },
}}>
  <div slot="hero" class="top"><Nav /></div>
  <article class="wrap profile">
    <a class="back" href={href(lang, '/about-us#team')}><Icon name="arrow" size={16} class="flip" /> {P.back[lang]}</a>
    <div class="layout">
      <div class="side">
        <div class="portrait">
          {photo && typeof photo !== 'string'
            ? <Image src={photo} alt={person.name} widths={[420, 840]} sizes="(max-width: 860px) 80vw, 380px" quality={80} loading="eager" />
            : photo ? <img src={photo} alt={person.name} /> : null}
        </div>
        {person.social_url && (
          <a class="social" href={person.social_url} target="_blank" rel="noopener">{socialLabel} <Icon name="external" size={16} /></a>
        )}
      </div>
      <div class="main">
        <p class="eyebrow">{person.group === 'leadership' ? (lang === 'id' ? 'Pimpinan' : 'Leadership') : (lang === 'id' ? 'Pakar dan peneliti' : 'Expert and researcher')}</p>
        <h1>{person.name}</h1>
        {role && <p class="role">{role}</p>}
        {bioInOtherLang && <p class="note">{P.bioNote[lang]}</p>}
        <div class="bio" lang={bioInOtherLang ? 'en' : lang}>{bio.map((para) => <p>{para}</p>)}</div>
      </div>
    </div>
  </article>

  <section class="section more">
    <div class="wrap">
      <h2>{P.others[lang]}</h2>
      <div class="grid">{others.map((p) => <PersonCard person={p} lang={lang} />)}</div>
    </div>
  </section>
</Base>

<style>
  .top { background: linear-gradient(180deg, #dfe7ea, var(--paper)); padding-bottom: 8px; }
  .profile { padding-top: 36px; padding-bottom: 40px; }
  .back { display: inline-flex; align-items: center; gap: 8px; color: var(--teal-ink); font-weight: 650; font-size: .9rem; }
  .back :global(.flip) { transform: rotate(180deg); }
  .layout { display: grid; grid-template-columns: 380px 1fr; gap: 64px; margin-top: 28px; align-items: start; }
  .side { position: sticky; top: 24px; }
  .portrait { border-radius: var(--r-lg); overflow: hidden; background: #eaf1ef; aspect-ratio: 4 / 5;
    box-shadow: 0 30px 60px -34px rgba(10, 40, 60, .55); }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .social { display: inline-flex; align-items: center; gap: 8px; margin-top: 18px; padding: 10px 18px; border-radius: var(--r-pill);
    border: 1.5px solid var(--navy); color: var(--navy); font-weight: 650; font-size: .9rem; }
  h1 { font-size: clamp(1.9rem, 1.3rem + 1.8vw, 2.6rem); margin-top: 10px; }
  .role { color: var(--teal-ink); font-weight: 650; font-size: 1.08rem; margin-top: 12px; }
  .note { margin-top: 20px; padding: 12px 16px; border-radius: 12px; background: var(--sage); color: var(--muted); font-size: .88rem; }
  .bio { margin-top: 28px; max-width: 700px; }
  .bio p { font-size: 1.04rem; line-height: 1.75; color: var(--ink); margin-bottom: 18px; }
  .more { padding-top: 40px; }
  .more h2 { font-size: 1.6rem; margin-bottom: 24px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; max-width: 920px; }
  @media (max-width: 860px) {
    .layout { grid-template-columns: 1fr; gap: 28px; }
    .side { position: static; max-width: 340px; }
    .grid { grid-template-columns: 1fr 1fr; gap: 12px; }
  }
  @media (max-width: 640px) {
    .bio p { font-size: 1rem; }
    .grid :global(.person:nth-child(3)) { display: none; }
  }
</style>
