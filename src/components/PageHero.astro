---
// Painted banner for inner pages. Glass sits only behind the text block.
import { getImage } from 'astro:assets';
import Nav from './Nav.astro';
import heroArt from '../assets/art/paint_hero.jpg';
import duskArt from '../assets/art/paint_dusk.jpg';

interface Props { eyebrow?: string; title: string; lede?: string; art?: 'day' | 'dusk'; compact?: boolean }
const { eyebrow, title, lede, art = 'day', compact = false } = Astro.props;
const src = art === 'dusk' ? duskArt : heroArt;
const widths = [960, 1600, 2400];
const imgs = await Promise.all(widths.map((w) => getImage({ src, width: w, format: 'webp', quality: 68 })));
const srcset = imgs.map((im, i) => `${im.src} ${widths[i]}w`).join(', ');
---
<header class:list={['page-hero', art, { compact }]}>
  <img class="art" src={imgs[1].src} srcset={srcset} sizes="100vw" alt="" fetchpriority="high" decoding="async" />
  <Nav />
  <div class="wrap">
    <div class="box">
      {eyebrow && <p class="eyebrow line">{eyebrow}</p>}
      <h1 set:html={title} />
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
  </div>
</header>

<style>
  .page-hero { position: relative; isolation: isolate; padding-bottom: 96px; min-height: 560px; }
  .page-hero.compact { min-height: 420px; padding-bottom: 64px; }
  .art { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: center 62%; }
  .page-hero::after { content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, rgba(232, 237, 238, .78) 0%, rgba(232, 237, 238, .45) 42%, rgba(232, 237, 238, 0) 70%),
                linear-gradient(180deg, rgba(232, 237, 238, .3), rgba(244, 239, 227, 0) 40%, rgba(244, 239, 227, .9) 100%); }
  .dusk.page-hero::after { background: linear-gradient(90deg, rgba(10, 30, 80, .55), rgba(10, 30, 80, .15) 60%, rgba(10, 30, 80, 0)),
                linear-gradient(180deg, rgba(10, 30, 80, .2), rgba(10, 30, 80, 0) 50%, rgba(244, 239, 227, .85) 100%); }
  .box { max-width: 720px; padding-top: 72px; }
  .compact .box { padding-top: 56px; }
  .eyebrow.line { display: flex; align-items: center; gap: 12px; }
  .eyebrow.line::before { content: ''; width: 34px; height: 2px; background: var(--teal); }
  h1 { margin: 16px 0 18px; font-size: clamp(2.3rem, 1.4rem + 2.6vw, 3.2rem); }
  .lede { color: #1f3a55; font-size: 1.08rem; max-width: 620px; }
  .dusk h1, .dusk .lede { color: #fff; }
  .dusk .eyebrow { color: var(--warm-soft); }
  .dusk .eyebrow.line::before { background: var(--warm-soft); }
  @media (max-width: 640px) {
    .page-hero, .page-hero.compact { min-height: 0; padding-bottom: 48px; }
    .box, .compact .box { padding-top: 40px; }
    h1 { font-size: 2.2rem; }
    .lede { font-size: 1rem; }
    .page-hero::after { background: linear-gradient(180deg, rgba(232, 237, 238, .86), rgba(232, 237, 238, .74) 60%, rgba(244, 239, 227, .97)); }
  }
</style>
