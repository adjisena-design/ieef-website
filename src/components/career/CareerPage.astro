---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import Icon from '../Icon.astro';
import { getCareers, pick, paragraphs } from '../../lib/content';
import { getLang, href } from '../../i18n/ui';
import { career as C } from '../../data/pages';

const lang = getLang(Astro.url);
const roles = (await getCareers()).sort((a, b) => Number(b.is_open) - Number(a.is_open) || a.sort - b.sort);
---
<Base title={C.title[lang]} description={C.lede[lang]}>
  <PageHero slot="hero" compact eyebrow="IEEF" title={C.title[lang]} lede={C.lede[lang]} />
  <section class="section list">
    <div class="wrap layout">
      <div>
        <h2>{C.openings[lang]}</h2>
        {roles.length === 0 && <p class="empty">{C.noRoles[lang]}</p>}
        <ul class="roles">
          {roles.map((r) => (
            <li>
              <a class="role" href={href(lang, `/career/${r.slug}`)}>
                <div>
                  <span class:list={['status', { closed: !r.is_open }]}>{r.is_open ? C.open[lang] : C.closed[lang]}</span>
                  <h3>{pick(r, 'title', lang)}</h3>
                  <p>{paragraphs(pick(r, 'intro', lang))[0]}</p>
                </div>
                <span class="go">{C.view[lang]} <Icon name="arrow" size={16} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="why card card-paper">
        <p class="eyebrow">{C.why[lang]}</p>
        <ul>{C.perks.map((p) => <li>{p[lang]}</li>)}</ul>
        <p class="q">{C.questions[lang]} <a href={href(lang, '/contact-us')}>{C.contact[lang]}</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .list { padding-top: 24px; }
  .layout { display: grid; grid-template-columns: 1fr 340px; gap: 48px; align-items: start; }
  h2 { margin-bottom: 24px; }
  .empty { color: var(--muted); }
  .roles { list-style: none; display: grid; gap: 16px; }
  .role { display: flex; align-items: center; justify-content: space-between; gap: 28px; padding: 26px 30px; border-radius: var(--r-lg);
    background: var(--paper-card); border: 1px solid rgba(19, 40, 63, .08); transition: transform .3s var(--ease-out, ease), box-shadow .3s var(--ease-out, ease); }
  .role:hover { transform: translateY(-3px); box-shadow: 0 22px 40px -26px rgba(10, 40, 60, .45); }
  .status { display: inline-block; padding: 4px 10px; border-radius: var(--r-pill); background: #d6eadf; color: #1d6b4f; font-size: .72rem; font-weight: 700;
    letter-spacing: .08em; text-transform: uppercase; }
  .status.closed { background: #ece6db; color: var(--muted); }
  h3 { margin: 10px 0 8px; font-size: 1.25rem; }
  .role p { color: var(--muted); font-size: .92rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .go { flex: none; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; font-weight: 650; font-size: .9rem; color: var(--navy); }
  .go :global(svg) { flex: none; }
  .why { position: sticky; top: 24px; }
  .why ul { margin: 16px 0 20px; padding-left: 18px; display: grid; gap: 12px; font-size: .94rem; color: #2a3f55; }
  .why li::marker { color: var(--teal-ink); }
  .q { font-size: .9rem; color: var(--muted); }
  .q a { color: var(--teal-ink); font-weight: 650; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } .why { position: static; } }
  @media (max-width: 560px) { .role { flex-direction: column; align-items: flex-start; gap: 14px; padding: 22px; } }
  @media (prefers-reduced-motion: reduce) { .role:hover { transform: none; } }
</style>
