---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import NewsCard from './NewsCard.astro';
import { getNews } from '../../lib/content';
import { getLang } from '../../i18n/ui';
import { news as N } from '../../data/pages';

const lang = getLang(Astro.url);
const items = await getNews();
const [first, ...rest] = items;
const years = [...new Set(items.map((n) => n.date.slice(0, 4)))];
---
<Base title={N.title[lang]} description={N.lede[lang]}>
  <PageHero slot="hero" compact eyebrow="IEEF" title={N.title[lang]} lede={N.lede[lang]} />
  <section class="section list">
    <div class="wrap">
      {first && <div class="lead"><NewsCard item={first} lang={lang} featured eager /></div>}
      {years.length > 1 && (
        <div class="bar" role="toolbar" aria-label={N.year[lang]}>
          <button class="chip on" data-f="all" aria-pressed="true">{N.all[lang]} <span>{rest.length}</span></button>
          {years.map((y) => (
            <button class="chip" data-f={y} aria-pressed="false">{y} <span>{rest.filter((n) => n.date.startsWith(y)).length}</span></button>
          ))}
        </div>
      )}
      <div class="grid">{rest.map((n, i) => <NewsCard item={n} lang={lang} eager={i < 3} />)}</div>
    </div>
  </section>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.bar .chip');
  const cards = document.querySelectorAll<HTMLElement>('.grid > .ncard');
  chips.forEach((c) => c.addEventListener('click', () => {
    const f = c.dataset.f;
    chips.forEach((x) => { const on = x === c; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(on)); });
    cards.forEach((card) => { card.hidden = f !== 'all' && card.dataset.year !== f; });
  }));
</script>

<style>
  .list { padding-top: 24px; }
  .lead { margin-bottom: 56px; }
  .bar { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 32px; }
  .chip { display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 16px; border-radius: var(--r-pill);
    border: 1px solid rgba(19, 40, 63, .16); background: var(--paper-card); color: var(--navy); font-weight: 600; font-size: .88rem; }
  .chip span { color: var(--muted); font-weight: 500; }
  .chip.on { background: var(--navy); color: #fff; border-color: var(--navy); }
  .chip.on span { color: rgba(255, 255, 255, .7); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px 28px; }
  .grid > :global([hidden]) { display: none; }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, 1fr); gap: 24px; } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } .lead { margin-bottom: 40px; } }
</style>
