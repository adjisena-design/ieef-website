---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import type { News } from '../../lib/content';
import { pick, formatDate } from '../../lib/content';
import { media } from '../../lib/media';
import { href, type Lang } from '../../i18n/ui';
import { news as N } from '../../data/pages';

interface Props { item: News; lang: Lang; featured?: boolean; eager?: boolean }
const { item, lang, featured = false, eager = false } = Astro.props;
const img = media(item.image);
const title = pick(item, 'title', lang);
const summary = pick(item, 'summary', lang) ?? pick(item, 'tagline', lang);
const year = item.date.slice(0, 4);
---
<a class:list={['ncard', { featured }]} href={href(lang, `/news/${item.slug}`)} data-year={year}>
  <div class="ph">
    {img && typeof img !== 'string'
      ? <Image src={img} alt="" widths={featured ? [640, 960, 1280] : [420, 720]} sizes={featured ? '(max-width: 860px) 92vw, 640px' : '(max-width: 560px) 92vw, (max-width: 1000px) 46vw, 380px'} quality={72} loading={eager ? 'eager' : 'lazy'} />
      : img ? <img src={img} alt="" loading={eager ? 'eager' : 'lazy'} /> : null}
    {featured && <span class="badge">{item.featured ? N.headline[lang] : N.latest[lang]}</span>}
  </div>
  <div class="txt">
    <p class="meta"><time datetime={item.date}>{formatDate(item.date, lang, featured ? 'long' : 'short')}</time>{item.place && <span>{item.place}</span>}</p>
    <h3>{title}</h3>
    {summary && <p class="sum">{summary}</p>}
    <span class="go">{N.read[lang]} <Icon name="arrow" size={16} /></span>
  </div>
</a>

<style>
  .ncard { display: flex; flex-direction: column; border-radius: var(--r-lg); overflow: hidden; background: var(--paper-card);
    border: 1px solid rgba(19, 40, 63, .08); height: 100%; }
  .ph { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #dfe6e3; }
  .ph :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease-out, ease); }
  .ncard:hover .ph :global(img) { transform: scale(1.04); }
  .badge { position: absolute; top: 14px; left: 14px; padding: 6px 12px; border-radius: var(--r-pill); background: var(--warm); color: var(--navy-deep);
    font-size: .74rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .txt { display: flex; flex-direction: column; gap: 10px; padding: 22px 24px 24px; flex: 1; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: .78rem; font-weight: 700; color: var(--teal-ink); }
  .meta span { color: var(--muted); font-weight: 600; }
  .meta span::before { content: '·'; margin-right: 14px; color: var(--muted); }
  h3 { font-size: 1.06rem; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .sum { color: var(--muted); font-size: .9rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .go { margin-top: auto; padding-top: 6px; display: inline-flex; align-items: center; gap: 8px; font-weight: 650; font-size: .88rem; color: var(--navy); }
  .ncard:hover { transform: translateY(-4px); box-shadow: 0 26px 46px -28px rgba(10, 40, 60, .5); }
  .ncard { transition: transform .3s var(--ease-out, ease), box-shadow .3s var(--ease-out, ease); }
  .featured { display: grid; grid-template-columns: 1.15fr 1fr; }
  .featured .ph { aspect-ratio: auto; min-height: 340px; }
  .featured .txt { padding: 36px 40px; justify-content: center; gap: 14px; }
  .featured h3 { font-size: clamp(1.35rem, 1rem + 1vw, 1.75rem); letter-spacing: -.02em; -webkit-line-clamp: 4; }
  .featured .sum { font-size: 1rem; -webkit-line-clamp: 4; }
  .featured .go { margin-top: 8px; }
  @media (max-width: 860px) {
    .featured { grid-template-columns: 1fr; }
    .featured .ph { min-height: 0; aspect-ratio: 16 / 10; }
    .featured .txt { padding: 24px; }
  }
  @media (prefers-reduced-motion: reduce) { .ncard:hover { transform: none; } }
</style>
