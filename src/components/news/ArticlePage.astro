---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Icon from '../Icon.astro';
import NewsCard from './NewsCard.astro';
import type { News } from '../../lib/content';
import { getNews, pick, paragraphs, formatDate } from '../../lib/content';
import { media } from '../../lib/media';
import { getLang, href } from '../../i18n/ui';
import { news as N } from '../../data/pages';

interface Props { item: News }
const { item } = Astro.props;
const lang = getLang(Astro.url);
const all = await getNews();
const i = all.findIndex((n) => n.slug === item.slug);
const more = [1, 2, 3].map((k) => all[(i + k) % all.length]).filter((n) => n.slug !== item.slug);
const img = media(item.image);
const title = pick(item, 'title', lang);
const tagline = pick(item, 'tagline', lang);
const englishOnly = lang === 'id' && !item.body_id;

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const URL_RE = /(https?:\/\/[^\s<]+[^\s<.,;:!?)\]'"])/g;
const isYouTube = (u: string) => /(?:youtube\.com|youtu\.be)\//.test(u);
type Block = { kind: 'p' | 'video' | 'source'; html: string; url?: string };
const blocks: Block[] = paragraphs(pick(item, 'body', lang)).map((p) => {
  const solo = p.match(/^(https?:\/\/\S+)$/);
  if (solo && isYouTube(solo[1])) return { kind: 'video', html: '', url: solo[1] };
  const html = esc(p).replace(URL_RE, (u) => `<a href="${u}" target="_blank" rel="noopener">${u.length > 60 ? u.slice(0, 57) + '...' : u}</a>`).replace(/\n/g, '<br>');
  return { kind: /^Source:/i.test(p) ? 'source' : 'p', html };
});
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const shareText = encodeURIComponent(title);
const description = (pick(item, 'summary', lang) ?? paragraphs(item.body_en)[0] ?? '').slice(0, 155);
const ogImage = img && typeof img !== 'string' ? img.src : typeof img === 'string' ? img : undefined;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'NewsArticle', headline: title.slice(0, 110), description,
  datePublished: item.date, inLanguage: englishOnly ? 'en' : lang, mainEntityOfPage: pageUrl,
  image: ogImage ? [new URL(ogImage, Astro.site).toString()] : undefined,
  author: { '@type': 'Organization', name: 'Institute for Energy, Economics & Finance', url: Astro.site?.toString() },
  publisher: { '@type': 'Organization', name: 'IEEF', logo: { '@type': 'ImageObject', url: new URL('/favicon.png', Astro.site).toString() } },
};
---
<Base title={title} description={description} image={ogImage} type="article" jsonLd={jsonLd}>
  <div slot="hero" class="top"><Nav /></div>
  <article class="wrap article">
    <a class="back" href={href(lang, '/news-and-article')}><Icon name="arrow" size={16} class="flip" /> {N.back[lang]}</a>
    <header class="head">
      <p class="meta"><time datetime={item.date}>{formatDate(item.date, lang, 'long')}</time>{item.place && <span>{item.place}</span>}</p>
      <h1>{title}</h1>
      {tagline && <p class="tagline">{tagline}</p>}
      {englishOnly && <p class="note">{N.englishOnly.id}</p>}
    </header>
    {img && (
      <figure class="hero-img">
        {typeof img !== 'string'
          ? <Image src={img} alt={title} widths={[720, 1100, 1500]} sizes="(max-width: 1100px) 92vw, 1040px" quality={78} loading="eager" />
          : <img src={img} alt={title} />}
      </figure>
    )}
    <div class="body">
      {blocks.map((b) => b.kind === 'video'
        ? <a class="video" href={b.url} target="_blank" rel="noopener"><span class="play" aria-hidden="true"></span>{N.watch[lang]}<Icon name="external" size={16} /></a>
        : <p class:list={[{ source: b.kind === 'source' }]} set:html={b.html} />)}
      {item.source_url && (
        <p class="source">{N.source[lang]}: <a href={item.source_url} target="_blank" rel="noopener">{item.source_label ?? item.source_url}</a></p>
      )}
      <div class="share">
        <span>{N.share[lang]}</span>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener">LinkedIn</a>
        <a href={`https://wa.me/?text=${shareText}%20${encodeURIComponent(pageUrl)}`} target="_blank" rel="noopener">WhatsApp</a>
        <button type="button" class="copy" data-url={pageUrl} data-done={N.copied[lang]}>{N.copy[lang]}</button>
      </div>
    </div>
  </article>
  <section class="section more">
    <div class="wrap">
      <h2>{N.more[lang]}</h2>
      <div class="grid">{more.map((n) => <NewsCard item={n} lang={lang} />)}</div>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.url!); b.textContent = b.dataset.done!; } catch { /* clipboard unavailable */ }
  }));
</script>

<style>
  .top { background: linear-gradient(180deg, #dfe8ea, var(--paper)); }
  .article { max-width: 1100px; padding-top: 28px; }
  .back { display: inline-flex; align-items: center; gap: 8px; font-weight: 650; font-size: .9rem; color: var(--teal-ink); }
  .back :global(.flip) { transform: rotate(180deg); }
  .head { max-width: 820px; margin: 28px 0 32px; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: .84rem; font-weight: 700; color: var(--teal-ink); }
  .meta span { color: var(--muted); font-weight: 600; }
  .meta span::before { content: '·'; margin-right: 14px; }
  h1 { margin-top: 14px; font-size: clamp(1.8rem, 1.2rem + 1.8vw, 2.6rem); line-height: 1.15; letter-spacing: -.03em; }
  .tagline { margin-top: 14px; font-size: 1.1rem; color: #36506a; font-style: italic; }
  .note { margin-top: 16px; display: inline-block; padding: 8px 14px; border-radius: 10px; background: var(--sage); font-size: .86rem; color: #2a4a43; }
  .hero-img { border-radius: var(--r-lg); overflow: hidden; background: #dfe6e3; box-shadow: var(--shadow-soft); }
  .hero-img :global(img) { width: 100%; max-height: 640px; object-fit: cover; }
  .body { max-width: 720px; margin: 44px auto 0; }
  .body p { font-size: 1.06rem; line-height: 1.8; color: #22344a; margin-bottom: 1.3em; }
  .body p :global(a), .source a { color: var(--teal-ink); text-decoration: underline; text-underline-offset: 3px; word-break: break-word; }
  .body p.source { font-size: .9rem; color: var(--muted); }
  .video { display: inline-flex; align-items: center; gap: 12px; margin: 4px 0 26px; padding: 12px 18px 12px 12px; border-radius: var(--r-pill);
    background: var(--navy); color: #fff; font-weight: 650; font-size: .92rem; }
  .play { width: 30px; height: 30px; border-radius: 50%; background: #e2463a; position: relative; }
  .play::after { content: ''; position: absolute; left: 12px; top: 9px; border-left: 10px solid #fff; border-top: 6px solid transparent; border-bottom: 6px solid transparent; }
  .share { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 36px; padding-top: 24px; border-top: 1px solid rgba(19, 40, 63, .12); }
  .share span { font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-right: 6px; }
  .share a, .share button { height: 38px; padding: 0 16px; display: inline-flex; align-items: center; border-radius: var(--r-pill);
    border: 1px solid rgba(19, 40, 63, .16); background: var(--paper-card); font-size: .86rem; font-weight: 600; color: var(--navy); }
  .share a:hover, .share button:hover { border-color: var(--teal-ink); color: var(--teal-ink); }
  .more { background: var(--paper-deep, #ece5d5); margin-top: 72px; }
  .more h2 { margin-bottom: 28px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, 1fr); } .grid > :global(:nth-child(3)) { display: none; } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } .body p { font-size: 1rem; } .head { margin: 20px 0 24px; } }
</style>
