---
import Icon, { type IconName } from './Icon.astro';
interface Props {
  href: string;
  variant?: 'navy' | 'warm' | 'ghost' | 'glass';
  icon?: IconName;
  external?: boolean;
  class?: string;
}
const { href, variant = 'navy', icon, external = false, class: cls } = Astro.props;
---
<a class:list={['btn', `btn-${variant}`, cls]} href={href}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
  <slot />{icon && <Icon name={icon} size={18} />}
</a>

<style>
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; height: 50px; padding: 0 24px;
    border-radius: var(--r-pill); font-weight: 650; font-size: .94rem; white-space: nowrap; transition: transform .15s ease, box-shadow .15s ease; }
  .btn:hover { transform: translateY(-1px); }
  .btn-navy { background: var(--navy); color: #fff; box-shadow: 0 12px 26px -14px rgba(8, 56, 104, .7); }
  .btn-warm { background: var(--warm); color: #fff; }
  .btn-ghost { border: 1.5px solid var(--navy); color: var(--navy); }
  .btn-glass { color: var(--navy); background: var(--glass-paper-bg); border: 1px solid var(--glass-paper-line);
    backdrop-filter: blur(var(--glass-blur)); -webkit-backdrop-filter: blur(var(--glass-blur)); }
</style>
