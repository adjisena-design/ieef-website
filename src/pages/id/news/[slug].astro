---
import ArticlePage from '../../../components/news/ArticlePage.astro';
import { getNews, type News } from '../../../lib/content';
export async function getStaticPaths() {
  return (await getNews()).map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props as { item: News };
---
<ArticlePage item={item} />
