---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getLang, alternate, t } from '../i18n/ui';

interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article'; jsonLd?: Record<string, unknown> }
const lang = getLang(Astro.url);
const { title, description = t(lang, 'site.tagline'), image = '/og-default.jpg', type = 'website', jsonLd } = Astro.props;
const fullTitle = title ? `${title} | IEEF` : `IEEF | ${t(lang, 'site.full')}`;
const alt = alternate(Astro.url);
const canonical = new URL(Astro.url.pathname, Astro.site);
// Preview builds stay out of search engines until launch. Set PUBLIC_INDEXABLE=true on the production build.
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
const enPath = lang === 'en' ? Astro.url.pathname : alt.path;
const org = {
  '@context': 'https://schema.org', '@type': 'ResearchOrganization', name: 'Institute for Energy, Economics & Finance', alternateName: 'IEEF',
  url: Astro.site?.toString(), logo: new URL('/favicon.png', Astro.site).toString(), email: 'ieef@ieef.or.id',
  address: { '@type': 'PostalAddress', streetAddress: 'Jl. Ganesa, Lb. Siliwangi, Coblong', addressLocality: 'Bandung', addressRegion: 'Jawa Barat', addressCountry: 'ID' },
  parentOrganization: { '@type': 'CollegeOrUniversity', name: 'School of Business and Management, Institut Teknologi Bandung' },
  sameAs: ['https://www.instagram.com/ieefofficial', 'https://www.linkedin.com/in/ieef'],
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <script is:inline>
    // enable the motion layer only when JS runs and the visitor hasn't asked for reduced motion
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    try { if (sessionStorage.getItem('ieef-lang-switch')) { document.documentElement.classList.add('no-intro'); sessionStorage.removeItem('ieef-lang-switch'); } } catch (e) {}
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {!indexable && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={lang} href={canonical} />
  <link rel="alternate" hreflang={alt.lang} href={new URL(alt.path, Astro.site)} />
  <link rel="alternate" hreflang="x-default" href={new URL(enPath, Astro.site)} />
  <link rel="sitemap" href="/sitemap.xml" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#083868" />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="IEEF" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? org)} />
</head>
<body>
  <slot name="hero"><Nav /></slot>
  <main id="main"><slot /></main>
  <Footer />
  <script>
    // Scroll reveal: tag common blocks, stagger siblings, reveal when they enter the viewport.
    const root = document.documentElement;
    if (root.classList.contains('motion') && 'IntersectionObserver' in window) {
      const SELECTORS = [
        'main .section .eyebrow', 'main .section h2', 'main .section .lede', 'main .head', 'main .about > *',
        'main .card', 'main .person', 'main .brief', 'main .fcard', 'main .door', 'main .facts li', 'main .expertise li',
        'main .partners li', 'main .news', 'main .rlist li', 'main .mission li', 'main .vision', 'main .group h2',
        'main .dusk-title', 'main .cta-box', 'main .bar .chip', 'main .platform', 'main .leader .excerpt',
      ].join(',');
      // skip items already on screen, nested items, and cards inside sideways scrollers (they reveal with their row)
      const els = Array.from(document.querySelectorAll<HTMLElement>(SELECTORS))
        .filter((el) => !el.closest('[data-reveal]') && !el.closest('.dash-grid') && el.getBoundingClientRect().top > window.innerHeight * 0.85);
      document.querySelectorAll<HTMLElement>('.dash-grid').forEach((g) => { if (g.getBoundingClientRect().top > window.innerHeight * 0.85) els.push(g); });
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -4% 0px', threshold: 0.01 });
      els.forEach((el) => {
        const sibs = el.parentElement ? Array.from(el.parentElement.children).filter((c) => els.includes(c as HTMLElement)) : [];
        el.style.setProperty('--i', String(Math.min(sibs.indexOf(el) % 4, 3)));
        el.setAttribute('data-reveal', '');
        io.observe(el);
      });
    }

    // lazy images fade in on arrival
    if (root.classList.contains('motion')) {
      document.querySelectorAll<HTMLImageElement>('main img[loading="lazy"]').forEach((img) => {
        if (img.complete && img.naturalWidth) return;
        img.classList.add('lz');
        const done = () => img.classList.add('lz-in');
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', done, { once: true });
      });
    }
  </script>
</body>
</html>
