{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ieef-website",
  "compatibility_date": "2025-09-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // run the worker on every request so the preview password covers all pages and files
    "run_worker_first": true
  },
  // keep variables set in the Cloudflare dashboard (e.g. PREVIEW_PASSWORD) between deploys
  "keep_vars": true,
  // ping Supabase every 3 days so the free project never pauses
  "triggers": { "crons": ["17 3 */3 * *"] },
  "observability": { "enabled": true }
}
